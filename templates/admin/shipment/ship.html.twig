{# A FoxPost feladás-gombja az admin rendelés-oldal szállítmány-paneljén.

   HOOKABLE a `codeconjure_carrier.admin.order.shipment.ship` hookon (#15):
   a `ship` slotot (`sylius_admin.order.show.content.sections.shipments.item.actions`
   → `ship` → `props.template`) a közös `codeconjure/sylius-carrier-bundle`
   sablonja tölti — egyetlen host-sor, akárhány szállító-plugin van. Minden
   szállító ebbe a hookba kapcsolódik, a saját „én kezelem-e ezt a módot?"
   feltételével.

   Ezért CSAK FoxPost-módnál rajzol bármit. Más szállítmánynál a kimenet
   üres, és a közös sablon a többi szállító akciójára, vagy ha az sincs, a
   Sylius alapgombjára esik vissza.

   A kontextus (`resource`, `form`, `attributes`) a `hookable_metadata`-ban
   jön: a Twig Hooks a hookable sablonnak csak azt adja át. #}
{% set resource = hookable_metadata.context.resource %}
{% set form = hookable_metadata.context.form %}
{% set attributes = hookable_metadata.context.attributes %}

{% if foxpost_handles_delivery(resource.method) and sylius_sm_can(resource, 'sylius_shipment', 'ship') %}
    {% form_theme form '@SyliusAdmin/shared/form_theme.html.twig' %}
    <div {{ attributes }}>
        {{ form_start(form, {
            'action': path('app_admin_foxpost_parcel_register', {shipmentId: resource.id}),
            'attr': {'class': 'ui loadable form', 'novalidate': 'novalidate'},
        }) }}
        <input type="hidden" name="_method" value="POST">
        <div class="input-group flex-nowrap">
            <button type="submit" class="btn" {{ sylius_test_html_attribute('shipment-ship-button') }}>
                {{ ux_icon('tabler:truck') }}
                {{ 'codeconjure.foxpost.ui.register_parcel'|trans }}
            </button>
        </div>
        {{ form_row(form._token) }}
        {{ form_end(form, {'render_rest': false}) }}
    </div>
{% endif %}
