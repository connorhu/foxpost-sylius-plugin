{% if resource.internalStatus.value in ['registered','label_ready','packed'] %}
    <form method="post" action="{{ path('app_admin_foxpost_parcel_cancel', {id: resource.id}) }}">
        <button type="submit" class="ui mini red button"
                onclick="return confirm('Biztosan?')">Mégse</button>
    </form>
{% endif %}
