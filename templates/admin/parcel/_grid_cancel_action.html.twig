{% if data.internalStatus.value in ['registered', 'label_ready', 'packed'] %}
    <form method="post" action="{{ path('app_admin_foxpost_parcel_cancel', {id: data.id}) }}">
        <button type="submit" class="btn btn-danger"
                onclick="return confirm('{{ 'codeconjure.foxpost.ui.cancel_confirm'|trans }}')">{{ action.label|trans }}</button>
    </form>
{% endif %}
